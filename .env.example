# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# After editing .env run:     docker compose up -d --force-recreate evolution-api
# (a plain "restart" does NOT re-read .env)

# --- Server ---
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://whatsapp.example.com

# --- Authentication ---
# Generate with: openssl rand -hex 32
AUTHENTICATION_API_KEY=CHANGE_ME
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Database (MariaDB / MySQL on the host) ---
# 172.17.0.1 = host address on the docker0 bridge (see README, "Database").
DATABASE_ENABLED=true
DATABASE_PROVIDER=mysql
DATABASE_CONNECTION_URI=mysql://evolution_user:CHANGE_ME@172.17.0.1:3306/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- Cache ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- Misc ---
WEBHOOK_GLOBAL_ENABLED=false
QRCODE_LIMIT=30
DEL_INSTANCE=false
LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
TELEMETRY=false
TZ=Europe/Istanbul
